DATABASE_URL=dbname=database
CLIENT_ORIGIN=http://localhost:5173
PORT=4567
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com
SMTP_STARTTLS=true
SESSION_SECRET=generate-a-long-random-secret
# Shared folder that holds the public resources to be served by the app.
GOOGLE_DRIVE_RESOURCES_FOLDER_ID=your_shared_folder_id_here
# Either set a JSON string or point to a service-account JSON file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json